{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "JARVIS: Health Check",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\run-health-check.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "JARVIS: List Full Regression Tests",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\run-full-tests.ps1",
        "-ListTests"
      ],
      "problemMatcher": []
    },
    {
      "label": "JARVIS: Run Full Regression",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\run-full-tests.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
